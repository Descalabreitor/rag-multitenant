# Copy to .env and fill in. Never commit .env.
# All values below are local-development placeholders.

# --- PostgreSQL ---------------------------------------------
POSTGRES_DB=ragmt
POSTGRES_PASSWORD=change-me-superuser
# Role passwords used by docker/postgres/initdb on first start.
# They must match the passwords inside the URLs below.
MIGRATOR_PASSWORD=change-me-migrator
APP_RW_PASSWORD=change-me-app
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Runtime connection: app_rw is NOT the table owner, has no SUPERUSER and no BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app@localhost:5432/ragmt
# Used only by Alembic (make migrate). Owns the tables.
MIGRATOR_DATABASE_URL=postgresql+asyncpg://migrator:change-me-migrator@localhost:5432/ragmt

# --- Keycloak / OIDC ----------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

OIDC_ISSUER=http://localhost:8080/realms/ragmt
OIDC_AUDIENCE=ragmt-api
# Allow-list of signing algorithms. Never include "none" or HS* here.
OIDC_ALGORITHMS=RS256
JWKS_CACHE_TTL_SECONDS=300

# Service account used by permsync to read orgs/users/groups.
PERMSYNC_CLIENT_ID=ragmt-permsync
PERMSYNC_CLIENT_SECRET=change-me-permsync

# --- LLM providers ------------------------------------------
# "ollama" (default, local) or "openai_compat" (optional, paid).
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_EMBED_MODEL=
OPENAI_COMPAT_CHAT_MODEL=

# Must match the vector column dimension in the migrations.
EMBEDDING_DIM=768

# --- API ----------------------------------------------------
LOG_LEVEL=INFO
