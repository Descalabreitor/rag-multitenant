# Copy to .env and fill in. Never commit .env.
# All values below are local-development placeholders.

# --- PostgreSQL ---------------------------------------------
POSTGRES_DB=ragmt
POSTGRES_PASSWORD=change-me-superuser
# Role passwords used by docker/postgres/initdb on first start.
# They must match the passwords inside the URLs below.
MIGRATOR_PASSWORD=change-me-migrator
APP_RW_PASSWORD=change-me-app
APP_INGEST_PASSWORD=change-me-ingest
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Runtime connection: app_rw is NOT the table owner, has no SUPERUSER and no BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app@127.0.0.1:5432/ragmt
# Writer connection for ingest, ACL changes and permsync (ADR 0004). Same limits as
# app_rw, but it sees the whole tenant instead of only what a user's ACLs allow.
INGEST_DATABASE_URL=postgresql+asyncpg://app_ingest:change-me-ingest@127.0.0.1:5432/ragmt
# Connection pool of the API's app_rw engine (persistent + extra connections).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Used only by Alembic (make migrate). Owns the tables.
MIGRATOR_DATABASE_URL=postgresql+asyncpg://migrator:change-me-migrator@127.0.0.1:5432/ragmt

# --- Keycloak / OIDC ----------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

OIDC_ISSUER=http://localhost:8080/realms/ragmt
OIDC_AUDIENCE=ragmt-api
# Allow-list of signing algorithms. Never include "none" or HS* here.
OIDC_ALGORITHMS=RS256
JWKS_CACHE_TTL_SECONDS=300

# Service account used by permsync to read users and groups (read-only roles).
# The realm import reads the secret from here, so it never lands in git.
PERMSYNC_CLIENT_ID=ragmt-permsync
PERMSYNC_CLIENT_SECRET=change-me-permsync
# Seconds from the start of one sync cycle to the next: the upper bound on how
# long a group removal in Keycloak takes to reach the database (ADR 0002).
PERMSYNC_INTERVAL_SECONDS=60
# Where permsync reaches Keycloak, if not at OIDC_ISSUER's origin. compose.yaml
# sets http://keycloak:8080 for its permsync container; leave unset on the host.
# PERMSYNC_KEYCLOAK_URL=

# keycloak/realm-export.json placeholders, resolved when the realm is imported
# (first start, or after deleting the realm). Development only.
# Password of every fictional seed user (alice, bob, erin, carol, dave).
KC_DEMO_USER_PASSWORD=change-me-demo
# DEV ONLY: enables the ragmt-dev-password client (username + password grant), so
# tests, `make e2e` and the README walkthrough can get tokens without a browser.
# Leave false anywhere but local development.
KC_DEV_PASSWORD_CLIENT=true

# --- LLM providers ------------------------------------------
# "ollama" (default, local) or "openai_compat" (optional, paid).
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_EMBED_MODEL=
OPENAI_COMPAT_CHAT_MODEL=

# Must match the vector column dimension in the migrations.
EMBEDDING_DIM=768

# --- API ----------------------------------------------------
LOG_LEVEL=INFO
