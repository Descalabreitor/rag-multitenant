  ],
  "clients": [
    {
      "clientId": "ragmt-cli",
      "name": "ragmt CLI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "organization"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "ragmt-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ragmt-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "description": "Command-line login: authorization code with PKCE (S256), loopback redirects only."
    },
    {
      "clientId": "ragmt-dev-password",
      "name": "DEV ONLY - password grant for local tests",
      "description": "DEVELOPMENT ONLY. Lets tests and the README walkthrough get user tokens with username + password. Disabled unless KC_DEV_PASSWORD_CLIENT=true at import. Never enable it outside local development.",
      "enabled": "${KC_DEV_PASSWORD_CLIENT:false}",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "organization"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "ragmt-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ragmt-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ragmt-permsync",
      "name": "ragmt permission sync",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PERMSYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": []
    }
  ]
}
