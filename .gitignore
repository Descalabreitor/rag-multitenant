# ============================================================
# rag-multitenant
# ============================================================

# --- Secrets & local config ---------------------------------
# Never commit real credentials. Placeholders go in .env.example.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
*.p12
secrets/

# --- Claude Code (personal, not shared) ---------------------
CLAUDE.local.md
.claude/settings.local.json
CLAUDE.md

# --- Local runtime data (docker volumes, models, uploads) ---
# Bind-mounted data dirs for postgres / keycloak / ollama.
.data/
pgdata/
keycloak-data/
ollama/
uploads/

# --- Evaluation & seed outputs ------------------------------
# Final tables/plots in docs/results/ ARE committed.
# Raw runs, caches and generated corpora are not.
eval/runs/
eval/.cache/
docs/results/raw/
seed/generated/
*.parquet
*.jsonl.gz

# --- Python bytecode ----------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# --- Packaging / build --------------------------------------
# Anchored to the root so they don't match folders inside src/.
/build/
/dist/
/lib/
/lib64/
/var/
/wheels/
*.egg-info/
.eggs/
*.egg
MANIFEST
.installed.cfg

# --- Environments -------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
__pypackages__/

# --- Tests, coverage & tooling caches -----------------------
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# --- Notebooks ----------------------------------------------
.ipynb_checkpoints/

# --- Logs ---------------------------------------------------
*.log
*.pid

# --- Editors ------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- OS -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
